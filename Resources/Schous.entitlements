<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime stenger mikrofonen uten denne, uansett hva TCC har sagt ja
	     til. Prosesstappen for systemlyd står ikke her: den er gatet av TCC
	     (NSAudioCaptureUsageDescription), ikke av hardened runtime. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
